{
  "name": "asteroid-coupled-viewer",
  "version": "0.1.0",
  "description": "Coupled 3D shape + light-curve viewer for DAMIT asteroid models. Side-by-side rotating mesh and synchronised observed-vs-predicted photometry.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/far-away/",
    "build:widget": "vite build --config vite.widget.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.166.1",
    "uplot": "^1.6.30"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/three": "^0.166.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
